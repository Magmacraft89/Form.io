<?xml version="1.0" encoding="utf-8"?>
<!-- Fondo de la pantalla de acceso: blanco abajo (detrás de la barra de navegación)
     y azul noche arriba (detrás de la barra de estado) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle"><solid android:color="@color/blanco" /></shape>
    </item>
    <item android:height="400dp" android:gravity="top">
        <shape android:shape="rectangle"><solid android:color="@color/azul_noche" /></shape>
    </item>
</layer-list>
