<?xml version="1.0" encoding="utf-8"?>
<!-- Círculo de la escala: menta si está elegido, blanco con borde si no -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="oval">
            <solid android:color="@color/verde_menta" />
            <stroke android:width="2dp" android:color="@color/verde_azulado" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/blanco" />
            <stroke android:width="1.5dp" android:color="@color/verde_azulado" />
        </shape>
    </item>
</selector>
