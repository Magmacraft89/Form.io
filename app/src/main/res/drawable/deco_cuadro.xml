<?xml version="1.0" encoding="utf-8"?>
<!-- Aro pequeño verde menta para las tarjetas cuadradas (no toca el ícono del centro) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="64dp" android:height="64dp" android:gravity="top|end"
        android:top="-32dp" android:right="-28dp">
        <shape android:shape="oval">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="9dp" android:color="@color/verde_menta" />
        </shape>
    </item>
</layer-list>
