<?xml version="1.0" encoding="utf-8"?>
<!-- Fondo de las pantallas de acceso: azul noche con círculos decorativos -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle"><solid android:color="@color/azul_noche" /></shape>
    </item>
    <item android:width="300dp" android:height="300dp" android:gravity="top|end"
        android:top="-130dp" android:right="-110dp">
        <shape android:shape="oval"><solid android:color="@color/verde_azulado" /></shape>
    </item>
    <item android:width="120dp" android:height="120dp" android:gravity="top|start"
        android:top="150dp" android:left="-50dp">
        <shape android:shape="oval">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="14dp" android:color="@color/verde_menta" />
        </shape>
    </item>
    <item android:width="34dp" android:height="34dp" android:gravity="top|end"
        android:top="200dp" android:right="40dp">
        <shape android:shape="oval"><solid android:color="@color/verde_menta" /></shape>
    </item>
</layer-list>
