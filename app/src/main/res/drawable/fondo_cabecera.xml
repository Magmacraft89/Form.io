<?xml version="1.0" encoding="utf-8"?>
<!-- Banda azul noche que continúa la Toolbar, con la parte de abajo curva
     y círculos decorativos: uno verde azulado, un aro menta y un punto menta -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/azul_noche" />
            <corners android:bottomLeftRadius="28dp" android:bottomRightRadius="28dp" />
        </shape>
    </item>
    <item android:width="170dp" android:height="170dp" android:gravity="top|end"
        android:top="-90dp" android:right="-60dp">
        <shape android:shape="oval"><solid android:color="@color/verde_azulado" /></shape>
    </item>
    <item android:width="60dp" android:height="60dp" android:gravity="top|end"
        android:top="36dp" android:right="100dp">
        <shape android:shape="oval">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="5dp" android:color="@color/verde_menta" />
        </shape>
    </item>
    <item android:width="56dp" android:height="56dp" android:gravity="top|start"
        android:top="-28dp" android:left="-18dp">
        <shape android:shape="oval"><solid android:color="@color/verde_menta" /></shape>
    </item>
</layer-list>
