<?xml version="1.0" encoding="utf-8"?>
<!-- 5.2 VER CADA RESPUESTA INDIVIDUAL (identificada solo por su número) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/blanco"
    android:orientation="vertical">

    <LinearLayout style="@style/Cabecera">

        <TextView
            android:id="@+id/txtDeTotal"
            style="@style/Etiqueta"
            android:backgroundTint="@color/verde_menta"
            android:textColor="@color/azul_noche" />

        <TextView
            android:id="@+id/txtTitulo"
            style="@style/CabeceraTitulo"
            android:layout_marginTop="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtFecha"
                style="@style/CabeceraTexto"
                android:layout_marginTop="0dp"
                android:drawableStart="@drawable/ic_calendario_p"
                android:drawablePadding="6dp"
                android:drawableTint="@color/verde_menta"
                android:gravity="center_vertical"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/txtDuracion"
                style="@style/CabeceraTexto"
                android:layout_marginStart="14dp"
                android:layout_marginTop="0dp"
                android:drawableStart="@drawable/ic_reloj_p"
                android:drawablePadding="6dp"
                android:drawableTint="@color/verde_menta"
                android:gravity="center_vertical"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/contenedor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp" />
    </androidx.core.widget.NestedScrollView>

    <!-- Navegación entre respuestas -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/fondo_barra_inferior"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="14dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAnterior"
            style="@style/BotonPrincipal"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="@string/anterior"
            app:icon="@drawable/ic_flecha_izq" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSiguiente"
            style="@style/BotonMenta"
            android:layout_width="0dp"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="@string/siguiente"
            app:icon="@drawable/ic_flecha_der"
            app:iconGravity="end" />
    </LinearLayout>
</LinearLayout>
