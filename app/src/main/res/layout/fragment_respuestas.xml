<?xml version="1.0" encoding="utf-8"?>
<!-- 5.1 LISTA DE RESPUESTAS RECIBIDAS (en tiempo real, sin datos personales) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/blanco"
    android:orientation="vertical">

    <LinearLayout style="@style/Cabecera">

        <TextView
            style="@style/CabeceraTitulo"
            android:text="@string/respuestas_titulo" />

        <TextView
            android:id="@+id/txtFormTitulo"
            style="@style/CabeceraTexto" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/verde_menta"
                android:textSize="36sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtTotalTexto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/blanco"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/respuestas_sub"
                    android:textColor="@color/blanco"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                style="@style/Etiqueta"
                android:backgroundTint="@color/verde_menta"
                android:text="@string/en_vivo"
                android:textColor="@color/azul_noche" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvRespuestas"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="16dp"
            android:paddingTop="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp" />

        <LinearLayout
            android:id="@+id/layoutVacio"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:background="@drawable/circulo_anillo"
                android:contentDescription="@string/desc_icono"
                android:padding="32dp"
                android:src="@drawable/ic_respuestas"
                app:tint="@color/verde_azulado" />

            <TextView
                style="@style/TextoTitulo"
                android:layout_marginTop="16dp"
                android:text="@string/sin_respuestas"
                android:textSize="18sp" />

            <TextView
                style="@style/TextoSecundario"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="@string/sin_respuestas_texto" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
