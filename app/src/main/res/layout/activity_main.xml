<?xml version="1.0" encoding="utf-8"?>
<!-- PANEL DEL ADMINISTRADOR
     DrawerLayout (menú lateral) con dos hijos:
       1) el contenido: Toolbar + contenedor donde se cambian las vistas (Fragments)
       2) el menú lateral: NavigationView -->
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- HIJO 1: CONTENIDO PRINCIPAL -->
    <LinearLayout
        android:id="@+id/contenido_principal"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/azul_noche"
        android:orientation="vertical">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/azul_noche"
            android:theme="@style/ThemeOverlay.Material3.Dark.ActionBar"
            app:popupTheme="@style/MenuToolbar"
            app:titleTextColor="@color/blanco" />

        <!-- Aquí se coloca la vista (Fragment) que se elige en el menú -->
        <FrameLayout
            android:id="@+id/contenedor_fragment"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/blanco" />
    </LinearLayout>

    <!-- HIJO 2: MENÚ LATERAL -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/blanco"
        app:headerLayout="@layout/nav_header"
        app:itemIconTint="@color/nav_item_color"
        app:itemTextColor="@color/nav_item_color"
        app:menu="@menu/drawer_menu" />

</androidx.drawerlayout.widget.DrawerLayout>
