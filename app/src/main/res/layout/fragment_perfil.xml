<?xml version="1.0" encoding="utf-8"?>
<!-- 1.4 DATOS DEL ADMINISTRADOR
     Foto de perfil editable, datos personales (ver / editar), cambiar contraseña y cerrar sesión -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/blanco">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="28dp">

        <!-- Cabecera con la foto -->
        <LinearLayout
            style="@style/Cabecera"
            android:gravity="center_horizontal"
            android:paddingTop="8dp"
            android:paddingBottom="68dp">

            <FrameLayout
                android:layout_width="116dp"
                android:layout_height="116dp">

                <!-- Aro menta + foto (o iniciales si no hay foto) -->
                <FrameLayout
                    android:layout_width="108dp"
                    android:layout_height="108dp"
                    android:layout_gravity="center"
                    android:background="@drawable/circulo"
                    android:backgroundTint="@color/verde_menta"
                    android:elevation="4dp"
                    android:padding="4dp">

                    <TextView
                        android:id="@+id/txtIniciales"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/circulo"
                        android:backgroundTint="@color/verde_azulado"
                        android:gravity="center"
                        android:textColor="@color/blanco"
                        android:textSize="36sp"
                        android:textStyle="bold" />

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/imgAvatar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/perfil_foto"
                        android:scaleType="centerCrop"
                        android:visibility="gone"
                        app:shapeAppearanceOverlay="@style/FormaCirculo" />
                </FrameLayout>

                <!-- Botón para cambiar la foto -->
                <ImageButton
                    android:id="@+id/btnCambiarFoto"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_gravity="bottom|end"
                    android:background="@drawable/circulo"
                    android:backgroundTint="@color/blanco"
                    android:contentDescription="@string/perfil_cambiar_foto"
                    android:elevation="6dp"
                    android:padding="9dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_camara"
                    app:tint="@color/azul_noche" />
            </FrameLayout>

            <TextView
                android:id="@+id/txtNombre"
                style="@style/CabeceraTitulo"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/txtCorreoCabecera"
                style="@style/CabeceraTexto"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/txtRol"
                style="@style/Etiqueta"
                android:layout_marginTop="10dp"
                android:backgroundTint="@color/verde_menta"
                android:textColor="@color/azul_noche" />
        </LinearLayout>

        <!-- Resumen de la cuenta -->
        <com.google.android.material.card.MaterialCardView
            style="@style/TarjetaBlanca"
            android:layout_marginStart="16dp"
            android:layout_marginTop="-44dp"
            android:layout_marginEnd="16dp"
            app:cardElevation="3dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="16dp"
                android:paddingBottom="16dp">

                <LinearLayout style="@style/MetricaContenedor">

                    <TextView
                        android:id="@+id/txtResFormularios"
                        style="@style/MetricaValor" />

                    <TextView
                        style="@style/MetricaEtiqueta"
                        android:text="@string/perfil_resumen_formularios" />
                </LinearLayout>

                <LinearLayout style="@style/MetricaContenedor">

                    <TextView
                        android:id="@+id/txtResRespuestas"
                        style="@style/MetricaValor" />

                    <TextView
                        style="@style/MetricaEtiqueta"
                        android:text="@string/perfil_resumen_respuestas" />
                </LinearLayout>

                <LinearLayout style="@style/MetricaContenedor">

                    <TextView
                        android:id="@+id/txtResActivos"
                        style="@style/MetricaValor" />

                    <TextView
                        style="@style/MetricaEtiqueta"
                        android:text="@string/perfil_resumen_activos" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Información personal: título + botón Editar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/TituloSeccion"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/perfil_datos" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEditar"
                style="@style/BotonTexto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="8dp"
                android:text="@string/accion_editar"
                app:icon="@drawable/ic_editar" />
        </LinearLayout>

        <!-- Modo ver -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardVer"
            style="@style/TarjetaBlanca"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="6dp"
                android:paddingEnd="16dp"
                android:paddingBottom="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/circulo"
                        android:backgroundTint="@color/verde_azulado"
                        android:contentDescription="@string/desc_icono"
                        android:padding="10dp"
                        android:src="@drawable/ic_perfil"
                        app:tint="@color/blanco" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/TextoSecundario"
                            android:text="@string/campo_nombre"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/txtVerNombre"
                            style="@style/TextoTitulo"
                            android:layout_width="match_parent"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textSize="15sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/circulo"
                        android:backgroundTint="@color/azul_noche"
                        android:contentDescription="@string/desc_icono"
                        android:padding="10dp"
                        android:src="@drawable/ic_correo_at"
                        app:tint="@color/verde_menta" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/TextoSecundario"
                            android:text="@string/campo_correo"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/txtVerCorreo"
                            style="@style/TextoTitulo"
                            android:layout_width="match_parent"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textSize="15sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/circulo"
                        android:backgroundTint="@color/verde_menta"
                        android:contentDescription="@string/desc_icono"
                        android:padding="10dp"
                        android:src="@drawable/ic_telefono"
                        app:tint="@color/azul_noche" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/TextoSecundario"
                            android:text="@string/campo_telefono"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/txtVerTelefono"
                            style="@style/TextoTitulo"
                            android:layout_width="match_parent"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textSize="15sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/circulo"
                        android:backgroundTint="@color/verde_azulado"
                        android:contentDescription="@string/desc_icono"
                        android:padding="10dp"
                        android:src="@drawable/ic_organizacion"
                        app:tint="@color/blanco" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/TextoSecundario"
                            android:text="@string/campo_organizacion"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/txtVerOrganizacion"
                            style="@style/TextoTitulo"
                            android:layout_width="match_parent"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textSize="15sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Modo editar -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardEditar"
            style="@style/TarjetaBlanca"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:visibility="gone"
            app:strokeColor="@color/verde_menta"
            app:strokeWidth="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="4dp"
                android:paddingEnd="16dp"
                android:paddingBottom="16dp">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilNombre"
                    style="@style/CampoTextoEstilo"
                    android:hint="@string/campo_nombre"
                    app:startIconDrawable="@drawable/ic_perfil">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etNombre"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPersonName|textCapWords"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilCorreo"
                    style="@style/CampoTextoEstilo"
                    android:hint="@string/campo_correo"
                    app:startIconDrawable="@drawable/ic_correo_at">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etCorreo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textEmailAddress"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilTelefono"
                    style="@style/CampoTextoEstilo"
                    android:hint="@string/campo_telefono"
                    app:startIconDrawable="@drawable/ic_telefono">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etTelefono"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="phone"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilOrganizacion"
                    style="@style/CampoTextoEstilo"
                    android:hint="@string/campo_organizacion"
                    app:startIconDrawable="@drawable/ic_organizacion">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etOrganizacion"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapWords"
                        android:maxLines="1" />
                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCancelar"
                        style="@style/BotonContorno"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="@string/cancelar" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGuardar"
                        style="@style/BotonPrincipal"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:text="@string/guardar"
                        app:icon="@drawable/ic_check" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Cuenta y seguridad -->
        <TextView
            style="@style/TituloSeccion"
            android:text="@string/perfil_seguridad" />

        <com.google.android.material.card.MaterialCardView
            style="@style/TarjetaBlanca"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/opcionContrasena"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/circulo"
                        android:backgroundTint="@color/verde_menta"
                        android:contentDescription="@string/desc_icono"
                        android:padding="10dp"
                        android:src="@drawable/ic_candado"
                        app:tint="@color/azul_noche" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/TextoTitulo"
                            android:text="@string/perfil_cambiar_contrasena"
                            android:textSize="15sp" />

                        <TextView
                            style="@style/TextoSecundario"
                            android:text="@string/perfil_cambiar_contrasena_desc"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="@string/desc_icono"
                        android:src="@drawable/ic_flecha_der"
                        app:tint="@color/verde_azulado" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/opcionSalir"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/circulo"
                        android:backgroundTint="@color/azul_noche"
                        android:contentDescription="@string/desc_icono"
                        android:padding="10dp"
                        android:src="@drawable/ic_salir"
                        app:tint="@color/verde_menta" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/TextoTitulo"
                            android:text="@string/menu_salir"
                            android:textSize="15sp" />

                        <TextView
                            style="@style/TextoSecundario"
                            android:text="@string/perfil_salir_desc"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="@string/desc_icono"
                        android:src="@drawable/ic_flecha_der"
                        app:tint="@color/verde_azulado" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            style="@style/TextoSecundario"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp"
            android:text="@string/perfil_version"
            android:textSize="12sp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
