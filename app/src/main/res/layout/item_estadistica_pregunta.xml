<?xml version="1.0" encoding="utf-8"?>
<!-- Tarjeta con la gráfica de una pregunta (6.2) -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/TarjetaBlanca"
    android:layout_marginBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtNumero"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/circulo"
                android:backgroundTint="@color/azul_noche"
                android:gravity="center"
                android:textColor="@color/verde_menta"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtPregunta"
                    style="@style/TextoTitulo"
                    android:layout_width="match_parent"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/txtDetalle"
                    style="@style/TextoSecundario"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/txtDestacado"
            style="@style/Etiqueta"
            android:layout_marginTop="10dp"
            android:backgroundTint="@color/verde_menta"
            android:drawableStart="@drawable/ic_escala_p"
            android:drawablePadding="4dp"
            android:drawableTint="@color/azul_noche"
            android:gravity="center_vertical"
            android:textColor="@color/azul_noche"
            android:textSize="13sp"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/contenedorGrafica"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
