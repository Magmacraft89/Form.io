<?xml version="1.0" encoding="utf-8"?>
<!-- 5.3 FORMULARIO WEB PARA PARTICIPANTES (vista previa dentro de la app)
     Así se ve la página que se abre al escanear el QR. Al enviar, la respuesta
     llega al instante a Respuestas y Estadísticas (tiempo real). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/blanco">

    <LinearLayout
        android:id="@+id/layoutFormulario"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtAvisoBorrador"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/verde_menta"
            android:drawableStart="@drawable/ic_alerta_p"
            android:drawablePadding="8dp"
            android:drawableTint="@color/azul_noche"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp"
            android:text="@string/vp_aviso_borrador"
            android:textColor="@color/azul_noche"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="16dp">

                <!-- Encabezado de la página web -->
                <LinearLayout
                    style="@style/Cabecera"
                    android:paddingBottom="22dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:contentDescription="@string/desc_logo"
                            android:src="@drawable/logo_formio" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="@string/app_name"
                            android:textColor="@color/verde_menta"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/txtTitulo"
                        style="@style/CabeceraTitulo"
                        android:layout_marginTop="12dp"
                        android:textSize="22sp" />

                    <TextView
                        android:id="@+id/txtDescripcion"
                        style="@style/CabeceraTexto" />

                    <TextView
                        style="@style/Etiqueta"
                        android:layout_marginTop="12dp"
                        android:backgroundTint="@color/verde_azulado"
                        android:text="@string/vp_anonimo"
                        android:textColor="@color/blanco" />
                </LinearLayout>

                <!-- Progreso por secciones -->
                <LinearLayout
                    android:id="@+id/layoutProgreso"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingTop="16dp"
                    android:paddingEnd="16dp">

                    <TextView
                        android:id="@+id/txtSeccionDe"
                        style="@style/TextoSecundario"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progreso"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:max="100"
                        app:indicatorColor="@color/verde_azulado"
                        app:trackColor="@color/verde_menta"
                        app:trackCornerRadius="4dp"
                        app:trackThickness="8dp" />
                </LinearLayout>

                <!-- Título de la sección actual -->
                <LinearLayout
                    android:id="@+id/layoutSeccion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginEnd="16dp"
                    android:background="@drawable/fondo_redondeado"
                    android:backgroundTint="@color/azul_noche"
                    android:orientation="vertical"
                    android:padding="14dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/txtSeccion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/verde_menta"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtSeccionDesc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/blanco"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/contenedorPreguntas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="16dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/fondo_borde_menta"
                    android:drawableStart="@drawable/ic_ojo_p"
                    android:drawablePadding="6dp"
                    android:drawableTint="@color/verde_azulado"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="4dp"
                    android:text="@string/vp_pie"
                    android:textColor="@color/verde_azulado"
                    android:textSize="11sp" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- Anterior / Siguiente / Enviar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/fondo_barra_inferior"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="14dp"
            android:paddingEnd="16dp"
            android:paddingBottom="14dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAnterior"
                style="@style/BotonPrincipal"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/anterior"
                app:icon="@drawable/ic_flecha_izq" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSiguiente"
                style="@style/BotonMenta"
                android:layout_width="0dp"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:text="@string/siguiente"
                app:icon="@drawable/ic_flecha_der"
                app:iconGravity="end" />
        </LinearLayout>
    </LinearLayout>

    <!-- Pantalla final: gracias / cerrado / ya respondiste -->
    <LinearLayout
        android:id="@+id/layoutFinal"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/fondo_login"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/imgFinal"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:background="@drawable/circulo_anillo"
            android:contentDescription="@string/desc_icono"
            android:padding="34dp"
            android:src="@drawable/ic_check"
            app:tint="@color/verde_azulado" />

        <TextView
            android:id="@+id/txtFinalTitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:textColor="@color/blanco"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtFinalTexto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textColor="@color/blanco"
            android:textSize="15sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOtra"
            style="@style/BotonMenta"
            android:layout_width="match_parent"
            android:layout_marginTop="28dp"
            android:text="@string/vp_otra" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVolverDetalle"
            style="@style/BotonTexto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/vp_volver"
            android:textColor="@color/blanco"
            app:icon="@drawable/ic_flecha_izq"
            app:iconTint="@color/blanco" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/vp_hecho_con"
            android:textColor="@color/verde_menta"
            android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>
