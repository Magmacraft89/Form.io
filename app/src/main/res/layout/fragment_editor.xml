<?xml version="1.0" encoding="utf-8"?>
<!-- 2.2 EDITAR + 3. CREADOR DE FORMULARIOS
     Título, descripción y lista de preguntas/secciones (se reordenan arrastrando) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/blanco"
    android:orientation="vertical">

    <!-- Título y descripción editables -->
    <LinearLayout
        style="@style/Cabecera"
        android:paddingTop="4dp"
        android:paddingBottom="20dp">

        <EditText
            android:id="@+id/etTitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:hint="@string/campo_titulo_form"
            android:importantForAutofill="no"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLength="80"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:textColor="@color/blanco"
            android:textColorHint="@color/verde_menta"
            android:textSize="22sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etDescripcion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:hint="@string/campo_descripcion_form"
            android:importantForAutofill="no"
            android:inputType="textCapSentences|textMultiLine"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:textColor="@color/blanco"
            android:textColorHint="@color/verde_menta"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/txtGuardado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:drawableStart="@drawable/ic_check_p"
            android:drawablePadding="4dp"
            android:drawableTint="@color/verde_menta"
            android:gravity="center_vertical"
            android:text="@string/editor_guardado"
            android:textColor="@color/verde_menta"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/txtCantidad"
            style="@style/TituloSeccion"
            android:layout_width="0dp"
            android:layout_marginTop="16dp"
            android:layout_weight="1"
            android:text="@string/editor_preguntas" />

        <TextView
            android:id="@+id/txtEstadoEditor"
            style="@style/Etiqueta"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="16dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/txtAyudaMover"
        style="@style/TextoSecundario"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="4dp"
        android:text="@string/editor_mover"
        android:textSize="12sp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvPreguntas"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="16dp"
            android:paddingTop="6dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp" />

        <TextView
            android:id="@+id/txtVacio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:background="@drawable/fondo_borde"
            android:drawableTop="@drawable/ic_formularios"
            android:drawablePadding="8dp"
            android:drawableTint="@color/verde_azulado"
            android:gravity="center"
            android:padding="24dp"
            android:text="@string/editor_vacio"
            android:textColor="@color/verde_azulado"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Barra inferior: agregar pregunta, agregar sección y vista previa -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/fondo_barra_inferior"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="14dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAgregarPregunta"
            style="@style/BotonMenta"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="@string/btn_pregunta"
            app:icon="@drawable/ic_agregar" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAgregarSeccion"
            style="@style/BotonPrincipal"
            android:layout_width="0dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="@string/btn_seccion"
            app:icon="@drawable/ic_seccion" />

        <ImageButton
            android:id="@+id/btnVistaPrevia"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/circulo"
            android:contentDescription="@string/vista_previa"
            android:padding="14dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_ojo"
            app:tint="@color/azul_noche" />
    </LinearLayout>
</LinearLayout>
