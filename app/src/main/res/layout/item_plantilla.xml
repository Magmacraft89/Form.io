<?xml version="1.0" encoding="utf-8"?>
<!-- Tarjeta de una plantilla: ícono de color, nombre, descripción y botones -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/TarjetaBlanca"
    android:layout_margin="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/deco_tarjeta_menta"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/imgPlantilla"
                style="@style/IconoTarjetaColor"
                android:contentDescription="@string/desc_icono" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Solo en las plantillas propias (guardadas en Firestore) -->
            <TextView
                android:id="@+id/txtPropia"
                style="@style/Etiqueta"
                android:backgroundTint="@color/azul_noche"
                android:text="@string/plantilla_propia"
                android:textColor="@color/blanco"
                android:textSize="10sp"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/btnEliminarPlantilla"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/accion_eliminar"
                android:padding="7dp"
                android:src="@drawable/ic_borrar"
                android:visibility="gone"
                app:tint="@color/azul_noche" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtNombre"
            style="@style/TextoTitulo"
            android:layout_width="match_parent"
            android:layout_marginTop="12dp"
            android:ellipsize="end"
            android:lines="2"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/txtDescripcion"
            style="@style/TextoSecundario"
            android:layout_width="match_parent"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:lines="3"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/txtPreguntas"
            style="@style/Etiqueta"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/verde_menta"
            android:textColor="@color/azul_noche"
            android:textSize="10sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnUsar"
            style="@style/BotonPrincipal"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="12dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/usar_plantilla_corto"
            android:textSize="13sp"
            app:cornerRadius="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVer"
            style="@style/BotonTexto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/vista_previa"
            android:textSize="12sp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
