<?xml version="1.0" encoding="utf-8"?>
<!-- Cabecera de las pantallas de acceso: logo, nombre y eslogan sobre azul noche -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/fondo_login"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="32dp"
    android:paddingTop="40dp"
    android:paddingEnd="32dp"
    android:paddingBottom="64dp">

    <ImageView
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:contentDescription="@string/desc_logo"
        android:elevation="8dp"
        android:src="@drawable/logo_formio" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/app_name"
        android:textColor="@color/blanco"
        android:textSize="32sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/fondo_chip"
        android:backgroundTint="@color/verde_menta"
        android:paddingStart="12dp"
        android:paddingTop="3dp"
        android:paddingEnd="12dp"
        android:paddingBottom="3dp"
        android:text="@string/empresa"
        android:textColor="@color/azul_noche"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="@string/eslogan"
        android:textColor="@color/blanco"
        android:textSize="14sp" />
</LinearLayout>
