<?xml version="1.0" encoding="utf-8"?>
<!-- 1.2 LOGIN: acceso seguro del administrador -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <include layout="@layout/cabecera_auth" />

        <!-- Hoja blanca con el formulario de acceso -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="-36dp"
            android:layout_weight="1"
            android:background="@drawable/fondo_hoja"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="28dp"
            android:paddingEnd="24dp"
            android:paddingBottom="24dp">

            <TextView
                style="@style/TextoTitulo"
                android:text="@string/login_titulo"
                android:textSize="24sp" />

            <TextView
                style="@style/TextoSecundario"
                android:layout_marginTop="2dp"
                android:text="@string/login_subtitulo" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilCorreo"
                style="@style/CampoTextoEstilo"
                android:layout_marginTop="20dp"
                android:hint="@string/campo_correo"
                app:startIconDrawable="@drawable/ic_correo_at">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etCorreo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textEmailAddress"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilContrasena"
                style="@style/CampoTextoEstilo"
                android:hint="@string/campo_contrasena"
                app:endIconMode="password_toggle"
                app:startIconDrawable="@drawable/ic_candado">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etContrasena"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <CheckBox
                    android:id="@+id/cbRecordarme"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:buttonTint="@color/verde_azulado"
                    android:checked="true"
                    android:text="@string/recordarme"
                    android:textColor="@color/azul_noche" />

                <TextView
                    android:id="@+id/btnOlvide"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:padding="8dp"
                    android:text="@string/olvide_contrasena"
                    android:textColor="@color/verde_azulado"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnIniciar"
                style="@style/BotonPrincipal"
                android:layout_width="match_parent"
                android:layout_marginTop="12dp"
                android:text="@string/btn_iniciar" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/fondo_borde_menta"
                android:drawableStart="@drawable/ic_rayo_p"
                android:drawablePadding="8dp"
                android:drawableTint="@color/verde_azulado"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingTop="8dp"
                android:paddingEnd="14dp"
                android:paddingBottom="8dp"
                android:text="@string/cuenta_prueba"
                android:textColor="@color/azul_noche"
                android:textSize="12sp" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="16dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    style="@style/TextoSecundario"
                    android:text="@string/sin_cuenta" />

                <TextView
                    android:id="@+id/btnIrRegistro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:padding="6dp"
                    android:text="@string/registrate"
                    android:textColor="@color/azul_noche"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
