<?xml version="1.0" encoding="utf-8"?>
<!-- 7. DASHBOARD: resumen general en tiempo real -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/blanco">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="100dp">

            <!-- Banda de bienvenida -->
            <LinearLayout
                style="@style/Cabecera"
                android:paddingBottom="76dp">

                <TextView
                    android:id="@+id/txtSaludo"
                    style="@style/CabeceraTitulo" />

                <TextView
                    style="@style/CabeceraTexto"
                    android:text="@string/dash_subtitulo" />
            </LinearLayout>

            <!-- 7.1 Respuestas de hoy (tarjeta menta que se monta sobre la banda) -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="-56dp"
                android:layout_marginEnd="16dp"
                app:cardBackgroundColor="@color/verde_menta"
                app:cardCornerRadius="18dp"
                app:cardElevation="3dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/deco_aro"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:drawableStart="@drawable/ic_respuestas_p"
                            android:drawablePadding="8dp"
                            android:drawableTint="@color/azul_noche"
                            android:gravity="center_vertical"
                            android:text="@string/dash_respuestas_hoy"
                            android:textColor="@color/azul_noche"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtHoy"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textColor="@color/azul_noche"
                            android:textSize="44sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/txtVsAyer"
                                style="@style/Etiqueta"
                                android:backgroundTint="@color/azul_noche"
                                android:textColor="@color/verde_menta" />

                            <TextView
                                style="@style/Etiqueta"
                                android:layout_marginStart="6dp"
                                android:backgroundTint="@color/blanco"
                                android:text="@string/en_vivo"
                                android:textColor="@color/azul_noche" />
                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 7.2 Activos, respuestas totales y por vencer (tarjetas cuadradas) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:baselineAligned="false"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="10dp">

                <com.devcore.formio.componentes.TarjetaCuadrada
                    android:id="@+id/cardActivos"
                    style="@style/TarjetaColor"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        style="@style/ContenidoCuadro"
                        android:background="@drawable/deco_aro"
                        android:backgroundTint="@color/verde_azulado">

                        <ImageView
                            style="@style/IconoTarjetaColor"
                            android:backgroundTint="@color/verde_azulado"
                            android:contentDescription="@string/desc_icono"
                            android:src="@drawable/ic_rayo"
                            app:tint="@color/blanco" />

                        <TextView
                            android:id="@+id/txtActivos"
                            style="@style/TituloTarjetaColor"
                            android:layout_marginTop="8dp"
                            android:textSize="22sp" />

                        <TextView
                            style="@style/TextoTarjetaColor"
                            android:text="@string/dash_activos" />
                    </LinearLayout>
                </com.devcore.formio.componentes.TarjetaCuadrada>

                <com.devcore.formio.componentes.TarjetaCuadrada
                    android:id="@+id/cardTotal"
                    style="@style/TarjetaColor"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        style="@style/ContenidoCuadro"
                        android:background="@drawable/deco_aro"
                        android:backgroundTint="@color/azul_noche">

                        <ImageView
                            style="@style/IconoTarjetaColor"
                            android:backgroundTint="@color/azul_noche"
                            android:contentDescription="@string/desc_icono"
                            android:src="@drawable/ic_estadisticas"
                            app:tint="@color/verde_menta" />

                        <TextView
                            android:id="@+id/txtTotal"
                            style="@style/TituloTarjetaColor"
                            android:layout_marginTop="8dp"
                            android:textSize="22sp" />

                        <TextView
                            style="@style/TextoTarjetaColor"
                            android:text="@string/dash_total" />
                    </LinearLayout>
                </com.devcore.formio.componentes.TarjetaCuadrada>

                <com.devcore.formio.componentes.TarjetaCuadrada
                    android:id="@+id/cardPorVencer"
                    style="@style/TarjetaColor"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        style="@style/ContenidoCuadro"
                        android:background="@drawable/deco_aro"
                        android:backgroundTint="@color/verde_menta">

                        <ImageView
                            style="@style/IconoTarjetaColor"
                            android:backgroundTint="@color/verde_menta"
                            android:contentDescription="@string/desc_icono"
                            android:src="@drawable/ic_reloj"
                            app:tint="@color/azul_noche" />

                        <TextView
                            android:id="@+id/txtPorVencerNum"
                            style="@style/TituloTarjetaColor"
                            android:layout_marginTop="8dp"
                            android:textSize="22sp" />

                        <TextView
                            style="@style/TextoTarjetaColor"
                            android:text="@string/dash_por_vencer" />
                    </LinearLayout>
                </com.devcore.formio.componentes.TarjetaCuadrada>
            </LinearLayout>

            <!-- Primera vez: todavía no hay formularios en Firestore -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardEmpezar"
                style="@style/TarjetaBlanca"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="16dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/deco_tarjeta_menta"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        style="@style/TextoTitulo"
                        android:layout_width="match_parent"
                        android:text="@string/dash_empezar_titulo"
                        android:textSize="17sp" />

                    <TextView
                        style="@style/TextoSecundario"
                        android:layout_width="match_parent"
                        android:layout_marginTop="4dp"
                        android:text="@string/dash_empezar_texto" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnEmpezarCrear"
                        style="@style/BotonPrincipal"
                        android:layout_width="match_parent"
                        android:layout_marginTop="14dp"
                        android:text="@string/dash_empezar_crear" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCargarEjemplos"
                        style="@style/BotonContorno"
                        android:layout_width="match_parent"
                        android:text="@string/dash_cargar_ejemplos" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Respuestas de la semana -->
            <TextView
                style="@style/TituloSeccion"
                android:text="@string/dash_semana" />

            <com.google.android.material.card.MaterialCardView
                style="@style/TarjetaBlanca"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp">

                <com.devcore.formio.graficas.GraficaLinea
                    android:id="@+id/graficaSemana"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="8dp" />
            </com.google.android.material.card.MaterialCardView>

            <!-- 7.3 Los que están por vencer -->
            <TextView
                style="@style/TituloSeccion"
                android:text="@string/dash_por_vencer" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvPorVencer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:paddingStart="16dp"
                android:paddingEnd="16dp" />

            <TextView
                android:id="@+id/txtSinPorVencer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/fondo_borde"
                android:padding="16dp"
                android:text="@string/dash_sin_por_vencer"
                android:textColor="@color/verde_azulado"
                android:visibility="gone" />

            <!-- Formularios activos (lista horizontal) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/TituloSeccion"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/dash_formularios_activos" />

                <TextView
                    android:id="@+id/btnVerTodos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:layout_marginEnd="12dp"
                    android:background="?attr/selectableItemBackground"
                    android:padding="8dp"
                    android:text="@string/ver_todos"
                    android:textColor="@color/verde_azulado"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvActivos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:paddingStart="10dp"
                android:paddingEnd="10dp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabCrear"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="20dp"
        android:text="@string/menu_nuevo"
        android:textColor="@color/azul_noche"
        app:backgroundTint="@color/verde_menta"
        app:icon="@drawable/ic_agregar"
        app:iconTint="@color/azul_noche" />
</FrameLayout>
